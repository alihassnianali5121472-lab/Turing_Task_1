{
  "job_name": "glm-4x-b44-b2",
  "jobs_dir": "C:\\Downloads\\jobs",
  "n_concurrent_trials": 2,
  "n_attempts": 4,
  "verifier": {
    "env": {
      "OPENAI_API_KEY": "${OPENAI_API_KEY}",
      "OPENAI_BASE_URL": "${OPENAI_BASE_URL}",
      "JUDGE_MODEL": "openai/glm-5.2"
    }
  },
  "agents": [
    {
      "name": "opencode",
      "model_name": "glm/glm-5.2",
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "OPENAI_BASE_URL": "${OPENAI_BASE_URL}"
      },
      "kwargs": {
        "opencode_config": {
          "provider": {
            "glm": {
              "npm": "@ai-sdk/openai-compatible",
              "name": "GLM Gateway",
              "options": {
                "baseURL": "${OPENAI_BASE_URL}",
                "apiKey": "{env:OPENAI_API_KEY}"
              },
              "models": {
                "glm-5.2": {
                  "name": "GLM-5.2",
                  "reasoning": true,
                  "interleaved": {
                    "field": "reasoning_content"
                  },
                  "limit": {
                    "context": 200000,
                    "output": 96000
                  },
                  "options": {
                    "max_tokens": 96000
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "tasks": [
    {
      "path": "task_path"
    }
  ],
  "retry": {
    "max_retries": 2
  }
}